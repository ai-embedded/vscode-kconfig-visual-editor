#
# Level 1 - Main Settings
#
CONFIG_L1_FEATURE=y

#
# Level 2 - Sub Settings
#
CONFIG_L2_FEATURE=y

#
# Level 3 - Nested Settings
#
CONFIG_L3_FEATURE=y

#
# Level 4 - Deep Settings
#
CONFIG_L4_FEATURE=y
CONFIG_L4_VALUE=50
# end of Level 4 - Deep Settings
# end of Level 3 - Nested Settings

#
# Level 3 - Another Branch
#
CONFIG_L3_ANOTHER_FEATURE=y
# end of Level 3 - Another Branch
# end of Level 2 - Sub Settings
# end of Level 1 - Main Settings

#
# Level 1 - Network Configuration
#
CONFIG_NETWORK_ENABLE=y

#
# Level 2 - WiFi Settings
#
CONFIG_WIFI_ENABLE=y
CONFIG_WIFI_SSID="MyNetwork"

#
# Level 3 - WiFi Security
#
# CONFIG_WIFI_AUTH_OPEN is not set
CONFIG_WIFI_AUTH_WPA2=y
# CONFIG_WIFI_AUTH_WPA3 is not set
CONFIG_WIFI_PASSWORD=""
# end of Level 3 - WiFi Security
# end of Level 2 - WiFi Settings

#
# Level 2 - Ethernet Settings
#
CONFIG_ETHERNET_ENABLE=y

#
# Level 3 - Ethernet PHY
#
CONFIG_ETH_PHY_ADDR=1
# end of Level 3 - Ethernet PHY
# end of Level 2 - Ethernet Settings
# end of Level 1 - Network Configuration

#
# Level 1 - Performance Tuning
#

#
# Level 2 - Memory Management
#
CONFIG_MEM_POOL_SIZE=256

#
# Level 3 - Allocator Configuration
#
CONFIG_USE_CUSTOM_ALLOCATOR=y
CONFIG_ALLOCATOR_DEBUG=y
# end of Level 3 - Allocator Configuration
# end of Level 2 - Memory Management

#
# Level 2 - CPU Optimization
#
CONFIG_CPU_FREQ_MAX=160
CONFIG_TASK_WDT_TIMEOUT=5
# end of Level 2 - CPU Optimization
# end of Level 1 - Performance Tuning
