CONFIG_TOP_LEVEL_CONFIG=y

#
# Basic Menu Test
#
CONFIG_BASIC_BOOL=y
CONFIG_BASIC_INT=10
CONFIG_BASIC_STRING="test_string"
# end of Basic Menu Test

#
# Nested Menu Test
#
# CONFIG_NESTED_ENABLE is not set
CONFIG_NESTED_PARENT_ITEM="parent"
# end of Nested Menu Test

#
# Deep Nesting Test
#
# CONFIG_DEEP_ENABLE is not set
# end of Deep Nesting Test

#
# Conditional Menu Test
#
CONFIG_CONDITIONAL_ITEM=y
# end of Conditional Menu Test

CONFIG_GZIP=y
# CONFIG_BZIP2 is not set
# CONFIG_LZ4 is not set

#
# Menu with Choice
#
CONFIG_MENU_CHOICE_ENABLE=y
CONFIG_OPTION_A=y
# CONFIG_OPTION_B is not set
# CONFIG_OPTION_C is not set
CONFIG_AFTER_CHOICE="after_choice"
# end of Menu with Choice

#
# Empty Menu Test
#

#
# Single Item Menu
#
CONFIG_SINGLE_ITEM=y
# end of Single Item Menu

#
# Complex Conditional Menu
#
# CONFIG_COMPLEX_ENABLE is not set
# end of Complex Conditional Menu

# CONFIG_MENUCONFIG_TEST is not set
CONFIG_FINAL_CONFIG=y
