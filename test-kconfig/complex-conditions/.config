CONFIG_ARCH_ARM=y
CONFIG_ARCH_RISCV=y
CONFIG_ARCH_X86=y
CONFIG_CPU_64BIT=y
CONFIG_DEBUG_MODE=y
CONFIG_RELEASE_MODE=y
CONFIG_OPTIMIZATION_LEVEL=0
CONFIG_ENABLE_DMA=y
CONFIG_ENABLE_CACHE=y
CONFIG_MEMORY_SIZE=0x100000

#
# 测试 1: 复杂的 depends on 表达式
#
CONFIG_COMPLEX_DEP_1=y
CONFIG_COMPLEX_DEP_3=y
CONFIG_COMPLEX_DEP_4=y
# end of 测试 1: 复杂的 depends on 表达式

#
# 测试 2: 复杂的 if 块嵌套
#
# end of 测试 2: 复杂的 if 块嵌套

#
# 测试 3: 组合多种条件属性
#
CONFIG_BASE_LIB_A=y
CONFIG_BASE_LIB_B=y
CONFIG_BASE_LIB_C=y
CONFIG_MEMORY_POOL_SIZE=8192
# end of 测试 3: 组合多种条件属性

#
# 测试 4: menu 和 if 块的复杂组合
#

#
# ARM 64位特性
#
CONFIG_ARM64_DEBUG_FEATURE=y

#
# ARM64 调试子菜单
#
CONFIG_ARM64_DMA_DEBUG=y
# end of ARM64 调试子菜单
# end of ARM 64位特性
# end of 测试 4: menu 和 if 块的复杂组合

#
# 测试 5: choice 与复杂条件
#
CONFIG_ALLOCATOR_STANDARD=y
# CONFIG_ALLOCATOR_POOLED is not set
# CONFIG_ALLOCATOR_SLAB is not set
# end of 测试 5: choice 与复杂条件

#
# 测试 6: 极端复杂的逻辑表达式
#
CONFIG_EXTREME_COMPLEX_2=y
# end of 测试 6: 极端复杂的逻辑表达式

#
# 测试 7: 多个 depends on
#
# end of 测试 7: 多个 depends on

#
# 测试 8: 嵌套 choice 与条件
#
CONFIG_PLATFORM_EMBEDDED=y
# CONFIG_PLATFORM_DESKTOP is not set
# CONFIG_PLATFORM_SERVER is not set
# end of 测试 8: 嵌套 choice 与条件

#
# 测试 9: 真实场景模拟
#
CONFIG_ENABLE_NETWORKING=y
CONFIG_NETWORK_BUFFER_SIZE=8192
CONFIG_LWIP=y
# CONFIG_CUSTOM_STACK is not set
CONFIG_LWIP_DEBUG=y
# end of 测试 9: 真实场景模拟
