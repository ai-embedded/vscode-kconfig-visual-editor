#
# System Configuration
#
CONFIG_SYSTEM_ENABLE=y

#
# Boot Configuration
#
CONFIG_BOOT_MODE=0
CONFIG_BOOT_FROM_FLASH=y
# CONFIG_BOOT_FROM_SD is not set
# CONFIG_BOOT_FROM_USB is not set

#
# Flash Configuration
#
CONFIG_FLASH_SIZE=0x400000
CONFIG_FLASH_FREQ=40

#
# Flash Partitions
#
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

#
# Individual Partition Settings
#
CONFIG_BOOTLOADER_SIZE=0x8000
CONFIG_APP_SIZE=0x100000
CONFIG_SPIFFS_SIZE=0x100000

#
# SPIFFS Advanced Settings
#
CONFIG_SPIFFS_PAGE_SIZE=256
CONFIG_SPIFFS_BLOCK_SIZE=4096
# end of SPIFFS Advanced Settings
# end of Individual Partition Settings
# end of Flash Partitions
# end of Flash Configuration
# end of Boot Configuration

#
# Memory Management
#
CONFIG_HEAP_SIZE=0x20000

#
# Memory Allocation Strategy
#
CONFIG_MALLOC_STANDARD=y
# CONFIG_MALLOC_POOLED is not set
# CONFIG_MALLOC_CUSTOM is not set

#
# Pooled Allocator Configuration
#
# end of Pooled Allocator Configuration
# end of Memory Allocation Strategy
# end of Memory Management
# end of System Configuration

#
# Network Configuration
#
CONFIG_NETWORK_ENABLE=y

#
# WiFi Configuration
#
CONFIG_WIFI_ENABLED=y
CONFIG_WIFI_SSID="MyNetwork"
CONFIG_WIFI_PASSWORD="1234"

#
# WiFi Advanced Settings
#
CONFIG_WIFI_CHANNEL=1
# CONFIG_WIFI_PS_NONE is not set
CONFIG_WIFI_PS_MIN_MODEM=y
# CONFIG_WIFI_PS_MAX_MODEM is not set

#
# WiFi Security Settings
#
# CONFIG_WIFI_AUTH_OPEN is not set
# CONFIG_WIFI_AUTH_WEP is not set
# CONFIG_WIFI_AUTH_WPA_PSK is not set
CONFIG_WIFI_AUTH_WPA2_PSK=y
# CONFIG_WIFI_AUTH_WPA_WPA2_PSK is not set
# CONFIG_WIFI_AUTH_WPA3_PSK is not set

#
# Enterprise Security (WPA2/WPA3 Enterprise)
#
CONFIG_WIFI_ENTERPRISE_ENABLE=y
CONFIG_WIFI_ENTERPRISE_USERNAME="123"
CONFIG_WIFI_ENTERPRISE_IDENTITY="234"
# end of Enterprise Security (WPA2/WPA3 Enterprise)
# end of WiFi Security Settings
# end of WiFi Advanced Settings
# end of WiFi Configuration

#
# Ethernet Configuration
#
CONFIG_ETHERNET_ENABLE=y

#
# Ethernet PHY Configuration
#
CONFIG_ETH_PHY_LAN8720=y
# CONFIG_ETH_PHY_TLK110 is not set
# CONFIG_ETH_PHY_RTL8201 is not set
# CONFIG_ETH_PHY_DP83848 is not set
CONFIG_ETH_PHY_ADDR=1
CONFIG_ETH_PHY_POWER_PIN=-1
# end of Ethernet PHY Configuration
# end of Ethernet Configuration

#
# TCP/IP Configuration
#
CONFIG_TCPIP_TASK_STACK_SIZE=3072

#
# DHCP Configuration
#
CONFIG_DHCP_CLIENT_ENABLE=y
CONFIG_DHCP_SERVER_ENABLE=y
CONFIG_DHCP_SERVER_LEASE_TIME=3600
# end of DHCP Configuration
# end of TCP/IP Configuration
# end of Network Configuration

#
# Security Features
#
CONFIG_SECURITY_ENABLE=y

#
# Encryption Settings
#
CONFIG_CRYPTO_HARDWARE_ENABLE=y

#
# Symmetric Encryption
#
CONFIG_AES_ENABLE=y
# CONFIG_AES_128 is not set
# CONFIG_AES_192 is not set
CONFIG_AES_256=y
# end of Symmetric Encryption

#
# Hash Functions
#
CONFIG_SHA_ENABLE=y
CONFIG_SHA1_ENABLE=y
CONFIG_SHA256_ENABLE=y
CONFIG_SHA512_ENABLE=y
# end of Hash Functions
# end of Encryption Settings

#
# Secure Boot
#
CONFIG_SECURE_BOOT_ENABLE=y
# CONFIG_SECURE_BOOT_V1 is not set
CONFIG_SECURE_BOOT_V2=y
# end of Secure Boot
# end of Security Features

#
# Power Management
#
CONFIG_POWER_MANAGEMENT_ENABLE=y

#
# Sleep Mode Configuration
#
CONFIG_POWER_MODE_NORMAL=y
# CONFIG_POWER_MODE_LIGHT_SLEEP is not set
# CONFIG_POWER_MODE_DEEP_SLEEP is not set

#
# Deep Sleep Configuration
#

#
# Wakeup Sources
#
# end of Wakeup Sources
# end of Deep Sleep Configuration
# end of Sleep Mode Configuration
# end of Power Management
