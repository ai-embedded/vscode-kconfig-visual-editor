CONFIG_ARCH_ARM=y
CONFIG_ARCH_RISCV=y
CONFIG_ARCH_X86=y
CONFIG_DEBUG_MODE=y
CONFIG_RELEASE_MODE=y
CONFIG_OPTIMIZATION_LEVEL=0

#
# 测试 1: 条件 Prompt
#
CONFIG_FEATURE_WITH_COND_PROMPT_1=y
CONFIG_FEATURE_WITH_COND_PROMPT_2=y
CONFIG_FEATURE_WITH_COND_PROMPT_3=y
CONFIG_FEATURE_WITH_COND_PROMPT_4=y
# end of 测试 1: 条件 Prompt

#
# 测试 2: 多条件 default (条件默认值)
#
CONFIG_STACK_SIZE=8192
CONFIG_THREAD_PRIORITY=2
CONFIG_MEMORY_SIZE=0x10000
CONFIG_ENABLE_FEATURE_X=y
# end of 测试 2: 多条件 default (条件默认值)

#
# 测试 3: 条件 select
#
CONFIG_BASE_FEATURE_1=y
CONFIG_BASE_FEATURE_2=y
CONFIG_BASE_FEATURE_3=y
CONFIG_SENSOR_SUPPORT=y
CONFIG_ADVANCED_SENSOR=y
# end of 测试 3: 条件 select

#
# 测试 4: visible if
#
CONFIG_VISIBLE_CONTAINER=y

#
# ARM 特定选项
#
CONFIG_ARM_SPECIFIC_1=y
CONFIG_ARM_SPECIFIC_2=50
# end of ARM 特定选项

#
# 调试选项
#
CONFIG_DEBUG_OPTION_1=y
CONFIG_DEBUG_OPTION_2=0xFF
# end of 调试选项

#
# 高级选项
#
CONFIG_ADVANCED_OPTION=y
# end of 高级选项
# end of 测试 4: visible if

#
# 测试 5: if 块的复杂条件
#
CONFIG_ENABLE_NETWORK=y
CONFIG_ENABLE_USB=y
CONFIG_ARM_DEBUG_1=y
CONFIG_ARM_DEBUG_2=42
CONFIG_PERIPHERAL_SUPPORT=y
CONFIG_CROSS_PLATFORM_DEBUG=y
# end of 测试 5: if 块的复杂条件

#
# 测试 6: range 条件表达式
#
CONFIG_BUFFER_SIZE=1024
# end of 测试 6: range 条件表达式

#
# 测试 7: 多种条件属性组合
#
CONFIG_COMBO_FEATURE=y
# end of 测试 7: 多种条件属性组合

#
# 测试 8: 嵌套的条件块
#
CONFIG_ARM_BASE=y
CONFIG_ARM_DEBUG_NESTED=y

#
# ARM 调试菜单
#
CONFIG_ARM_DEBUG_OPTION=10
# end of ARM 调试菜单
# end of 测试 8: 嵌套的条件块

#
# 测试 9: 否定组合条件属性
#
CONFIG_FEATURE_SMP_MODE=y
CONFIG_FEATURE_AMP_MODE=y
CONFIG_FEATURE_GIC_V2=y
CONFIG_FEATURE_GIC_V3=y
CONFIG_FEATURE_ETHERNET=y
CONFIG_FEATURE_PWM_OUTPUT=y
CONFIG_FEATURE_UART_CORE=y
CONFIG_FEATURE_NORDIC_EXT=y
CONFIG_SINGLE_CORE_LIMIT=1
CONFIG_FALLBACK_INTERRUPT_ROUTER=y
CONFIG_SAFETY_BACKOFF=y
CONFIG_UART_NORDIC_BRIDGE=y
# end of 测试 9: 否定组合条件属性
