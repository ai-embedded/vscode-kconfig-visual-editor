CONFIG_OPTIMIZATION_LEVEL=0
CONFIG_THREAD_PRIORITY=100
CONFIG_MEMORY_SIZE=0x10000
CONFIG_CPU_FREQUENCY=100
CONFIG_FEATURE_ENABLED=y

#
# 测试 1: 等于运算符 (=)
#
CONFIG_TEST_EQ_OPT0=y
CONFIG_TEST_EQ_PRIORITY=y
CONFIG_TEST_EQ_HEX=y
# end of 测试 1: 等于运算符 (=)

#
# 测试 2: 不等于运算符 (!=)
#
# end of 测试 2: 不等于运算符 (!=)

#
# 测试 3: 小于运算符 (<)
#
CONFIG_TEST_LT_OPT=y
# end of 测试 3: 小于运算符 (<)

#
# 测试 4: 大于运算符 (>)
#
# end of 测试 4: 大于运算符 (>)

#
# 测试 5: 小于等于运算符 (<=)
#
CONFIG_TEST_LE_OPT=y
CONFIG_TEST_LE_PRIORITY=y
# end of 测试 5: 小于等于运算符 (<=)

#
# 测试 6: 大于等于运算符 (>=)
#
CONFIG_TEST_GE_PRIORITY=y
CONFIG_TEST_GE_FREQ=y
# end of 测试 6: 大于等于运算符 (>=)

#
# 测试 7: 比较运算符与逻辑运算符组合
#
CONFIG_TEST_COMP_OR_1=y
CONFIG_TEST_COMP_NOT=y
# end of 测试 7: 比较运算符与逻辑运算符组合

#
# 测试 8: 复杂的比较表达式组合
#
CONFIG_TEST_COMPLEX_NESTED=y
# end of 测试 8: 复杂的比较表达式组合

#
# 测试 9: 比较运算符在不同上下文中
#
CONFIG_AUTO_ENABLE_HIGH_PERF=y

#
# 高性能选项
#
# end of 高性能选项
# end of 测试 9: 比较运算符在不同上下文中

#
# 测试 10: 边界条件测试
#
CONFIG_TEST_BOUNDARY_MIN=y
CONFIG_TEST_BOUNDARY_RANGE=y
# end of 测试 10: 边界条件测试
