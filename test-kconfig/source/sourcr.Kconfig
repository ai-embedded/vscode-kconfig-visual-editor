# Main Kconfig file - source series keyword test (corrected version)
# Tests VSCode Kconfig extension support for source, rsource, osource, orsource

mainmenu "Source Series Keyword Test"

# Test source: absolute path or relative to project root (note: source should not be indented)
source "sub/basic.kconfig"
# Test rsource: relative to current file directory
rsource "sub/relative.kconfig"
# Test osource: optional source, no error when file doesn't exist
osource "sub/optional-missing.kconfig"
osource "sub/optional-exists.kconfig"

# Test orsource: optional relative path source
orsource "sub/optional-relative-missing.kconfig"
orsource "sub/optional-relative-exists.kconfig"

menu "Source Functionality Test"

    config TEST_SOURCE_BASIC
        bool "Basic source test"
        help
          Tests basic source functionality for including other Kconfig files.


    config TEST_RSOURCE_BASIC
        bool "Basic rsource test"
        help
          Tests rsource functionality, path resolution relative to current file directory.



    config TEST_OSOURCE_BASIC
        bool "Basic osource test"
        help
          Tests osource functionality, optional source (no error when file doesn't exist).



    config TEST_ORSOURCE_BASIC
        bool "Basic orsource test"
        help
          Tests orsource functionality, optional relative path source.



endmenu

menu "Glob Pattern Test"

    config TEST_GLOB_PATTERNS
        bool "Glob pattern test"
        help
          Tests source series keywords support for glob wildcard patterns.

# Test glob pattern matching
source "patterns/*.kconfig"

# Optional glob pattern
osource "patterns/opt_*.kconfig"

# Relative path glob pattern
rsource "patterns/rel_*.kconfig"

endmenu

menu "Nested Source Test"

    config TEST_NESTED_SOURCE
        bool "Nested source test"
        help
          Tests nested source file inclusion.

# Nested test
source "nested/level1.kconfig"

endmenu

# Test using source in if block
if TEST_SOURCE_BASIC

menu "Conditional Source Test"

    config TEST_CONDITIONAL_SOURCE
        bool "Conditional source test"
        help
          Tests using source series keywords in conditional blocks.

# source in if block
rsource "sub/conditional.kconfig"

endmenu

endif
