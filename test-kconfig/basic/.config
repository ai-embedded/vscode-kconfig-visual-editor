CONFIG_SECONDARY_FEATURE=y

#
# Network Settings
#
CONFIG_NETWORK_ENABLED=y
CONFIG_NETWORK_PORT=8080
CONFIG_NETWORK_PROTOCOL="TCP"
CONFIG_NETWORK_MODE_CLIENT=y
# CONFIG_NETWORK_MODE_SERVER is not set
# CONFIG_NETWORK_MODE_BOTH is not set
# end of Network Settings

#
# Security Settings
#
CONFIG_SECURITY_ENABLED=y
CONFIG_SECURITY_LEVEL=5
CONFIG_SECURITY_ENCRYPTION=y
CONFIG_SECURITY_KEY_SIZE=256
# end of Security Settings
