{
  "name": "kconfig-visual-editor",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.2.3",
  "license": "Apache-2.0",
  "publisher": "flyingcys",
  "icon": "resources/icons/install-complete.png",
  "galleryBanner": {
    "color": "#2c3e50",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.60.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ai-embedded/vscode-kconfig-visual-editor.git"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters"
  ],
  "keywords": [
    "kconfig",
    "menuconfig",
    "kernel",
    "configuration",
    "build system",
    "linux",
    "embedded"
  ],
  "activationEvents": [
    "onLanguage:kconfig",
    "onCommand:kconfig.menuconfig.start"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "kconfig",
        "aliases": [
          "Kconfig",
          "kconfig"
        ],
        "extensions": [
          "Kconfig",
          "Kconfig.*"
        ],
        "filenames": [
          "Kconfig",
          "Kconfig.projbuild",
          "Kconfig.in"
        ],
        "configuration": "./kconfig-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kconfig",
        "scopeName": "source.kconfig",
        "path": "./syntaxes/kconfig.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "kconfig",
        "path": "./snippets/kconfig.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "kconfig.menuconfig.start",
        "title": "%command.menuconfig.start%",
        "category": "Kconfig",
        "icon": {
          "light": "resources/icons/light/config.svg",
          "dark": "resources/icons/dark/config.svg"
        }
      },
      {
        "command": "kconfig.saveDefconfig",
        "title": "%command.saveDefconfig%",
        "category": "Kconfig"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "when": "resourceFilename == Kconfig || resourceFilename =~ /^Kconfig\\..*$/",
          "command": "kconfig.menuconfig.start",
          "group": "z_kconfig"
        }
      ],
      "editor/context": [
        {
          "when": "resourceLangId == kconfig",
          "command": "kconfig.menuconfig.start",
          "group": "z_kconfig"
        }
      ],
      "editor/title": [
        {
          "when": "resourceLangId == kconfig",
          "command": "kconfig.menuconfig.start",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "%configuration.title%",
      "properties": {
        "kconfig.enableValidation": {
          "scope": "resource",
          "type": "boolean",
          "default": true,
          "description": "%config.enableValidation%"
        },
        "kconfig.autoHeaderPath": {
          "scope": "resource",
          "type": "string",
          "default": "config.h",
          "description": "%config.autoHeaderPath%"
        },
        "kconfig.uiTheme": {
          "scope": "window",
          "type": "string",
          "default": "default",
          "enum": ["default", "modern"],
          "enumDescriptions": [
            "%config.uiTheme.default%",
            "%config.uiTheme.modern%"
          ],
          "description": "%config.uiTheme%"
        },
        "kconfig.rtThread.pkgsDir": {
          "scope": "window",
          "type": "string",
          "default": "~/.env/packages",
          "order": 50,
          "markdownDescription": "%config.rtThread.pkgsDir%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "webpack --mode production",
    "compile": "webpack --mode development",
    "watch": "webpack --mode development --watch",
    "package": "webpack --mode production",
    "analyze": "ANALYZE=true webpack --mode production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package-extension": "vsce package --no-rewrite-relative-links",
    "publish-extension": "vsce publish --no-rewrite-relative-links"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "16.x",
    "@types/vscode": "^1.60.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vscode/vsce": "^2.19.0",
    "@vue/compiler-sfc": "^3.3.4",
    "assert": "^2.0.0",
    "css-loader": "^6.8.1",
    "eslint": "^8.20.0",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "sass": "^1.64.1",
    "sass-loader": "^13.3.2",
    "stream-browserify": "^3.0.0",
    "ts-loader": "^9.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^4.7.4",
    "vue-loader": "^17.2.2",
    "vue-style-loader": "^4.1.3",
    "webpack": "^5.74.0",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^4.10.0"
  },
  "dependencies": {
    "@iconify-prerendered/vue-codicon": "^0.28.1751607346",
    "@types/glob": "^8.1.0",
    "@vscode/codicons": "^0.0.35",
    "file-loader": "^6.2.0",
    "glob": "^11.0.3",
    "pinia": "^2.1.6",
    "vscode-languageclient": "^8.0.2",
    "vscode-languageserver": "^8.0.2",
    "vscode-languageserver-textdocument": "^1.0.5",
    "vue": "^3.3.4"
  },
  "vsce": {
    "rewriteRelativeLinks": false
  }
}
